# Hugging Face Token (requerido para descargar modelos restringidos como Gemma)
HF_TOKEN=tu_token_de_huggingface_aqui

# Clave API para autenticar peticiones en el servidor OpenAI-compatible de vLLM
API_KEY=token-abc123

# Seguridad: Restringir Clave Maestra solo a microservicios internos (false por defecto)
ALLOW_MASTER_KEY_ON_GATEWAY=false

# Control de intrusión y perímetro (Fail2ban y Lista Negra)
# Intentos fallidos antes de baneo automático en MongoDB
FAIL2BAN_MAX_FAILURES=3
# Ventana de tiempo en segundos para acumular fallos
FAIL2BAN_WINDOW_SECONDS=300
# Duración en horas del baneo automático
FAIL2BAN_BAN_HOURS=48
# Cantidad de avisos 403 devueltos a una IP en lista negra antes de activar drop silencioso (0 bytes / Connection: close)
BLACKLIST_MAX_NOTICES=3
# Excluir loopback (127.0.0.0/8, ::1) de auto-baneos de Fail2ban para evitar self-DoS (true por defecto; false para seguridad extrema)
FAIL2BAN_EXCLUDE_LOOPBACK=true



# Proxies de confianza (IP o CIDR separados por coma) autorizados a propagar la IP
# real del cliente via X-Forwarded-For / X-Real-IP. Solo se confía en esas cabeceras
# cuando la conexion directa (socket) proviene de uno de estos rangos; en cualquier
# otro caso se usa la IP del socket y se ignoran las cabeceras (anti-suplantacion).
# Si se deja vacio se usa un default seguro (solo loopback). Anade aqui tu Caddy/Nginx
# si hay uno delante para conservar la IP real de los clientes.
TRUSTED_PROXIES=

# Configuración del servidor vLLM
HOST=0.0.0.0
PORT=8000
MODEL=nvidia/Gemma-4-26B-A4B-NVFP4
VLLM_MODEL_ID=CorpAI-Gen
VLLM_ALIAS="CorpAI-Gen | Legal & Compliance"

# Optimización de Memoria y GPU (RTX 3090 24GB)
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=64
KV_CACHE_DTYPE=bfloat16
MAX_NUM_BATCHED_TOKENS=4096
ENABLE_PREFIX_CACHING=True

# CPU Offload / Swap Space (0 para máxima velocidad en VRAM GPU; >0 para habilitar swap a RAM)
SWAP_SPACE=0

# Cuantización opcional en tiempo de ejecución (ej. bitsandbytes, fp8, awq)
# QUANTIZATION=bitsandbytes
# LOAD_8_BITS=False # Establecer en True para forzar cuantización de 8 bits en lugar de 4 bits cuando QUANTIZATION=bitsandbytes

# Configuración llama.cpp (Motor Local Alternativo)
# LLAMA_MODEL_ID=CorpAI-Gen
# LLAMA_ALIAS="CorpAI-Gen | Legal & Compliance"
# LLAMA_PARALLEL=2
# LLAMA_CTX_SIZE=131072
# LLAMA_IS_MOE=false  # true para modelos MoE (ej: Qwen MoE, Mixtral) | false para modelos densos
# LLAMA_N_CPU_MOE=0   # Capas de expertos a CPU si LLAMA_IS_MOE=true
# LLAMA_CACHE_TYPE_K=f16 # Cuantización KV Cache K (f16, q4_0, q8_0)
# LLAMA_CACHE_TYPE_V=f16 # Cuantización KV Cache V (f16, q4_0, q8_0)

# Configuración de Poda de Contexto y Ventana Segura (Olvido Selectivo)
# GATEWAY_MAX_CONTEXT_TOKENS=32000
# GATEWAY_MAX_USER_TURNS=6

# Gobernanza Perimétrica Central de Hiperparámetros de Muestreo (Sampling Defaults)
# Estos valores por defecto solo se inyectan en peticiones locales que NO especifiquen sus propios parámetros
# (preserva intactos los valores explícitos definidos en modelos virtuales de Open-WebUI o sliders del usuario).
GATEWAY_DEFAULT_TEMPERATURE=0.80
GATEWAY_DEFAULT_MIN_P=0.05
GATEWAY_DEFAULT_TOP_P=0.95
GATEWAY_DEFAULT_TOP_K=40

# ==============================================================================
# Microservicio Evaluador de Suficiencia RAG (CRAG) - twil-lm3 (SmolLM3 3.1B GRPO)
# ==============================================================================
EVALUATOR_BACKEND_PORT=18300
EVALUATOR_MODEL=$LLAMA_DIR/models/twil-lm3-q4_k_m.gguf
EVALUATOR_ALIAS=twil-lm3-q4_k_m
EVALUATOR_CTX_SIZE=8192
EVALUATOR_BATCH_SIZE=2048
EVALUATOR_UBATCH_SIZE=512
EVALUATOR_GPU_LAYERS=99
EVALUATOR_THREADS=8
EVALUATOR_PARALLEL=1
EVALUATOR_CACHE_TYPE_K=q4_0
EVALUATOR_CACHE_TYPE_V=q4_0
RAG_MIN_SCORE=0.50
RAG_MAX_DELTA=0.30

