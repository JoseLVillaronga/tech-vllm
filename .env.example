# Hugging Face Token (requerido para descargar modelos restringidos como Gemma)
HF_TOKEN=tu_token_de_huggingface_aqui

# Clave API para autenticar peticiones en el servidor OpenAI-compatible de vLLM
API_KEY=token-abc123

# Proxies de confianza (IP o CIDR separados por coma) autorizados a propagar la IP
# real del cliente via X-Forwarded-For / X-Real-IP. Solo se confía en esas cabeceras
# cuando la conexion directa (socket) proviene de uno de estos rangos; en cualquier
# otro caso se usa la IP del socket y se ignoran las cabeceras (anti-suplantacion).
# Si se deja vacio se usa un default seguro (solo loopback). Anade aqui tu Caddy/Nginx
# si hay uno delante para conservar la IP real de los clientes.
TRUSTED_PROXIES=

# Configuración del servidor vLLM
HOST=0.0.0.0
PORT=8000
MODEL=nvidia/Gemma-4-26B-A4B-NVFP4

# Optimización de Memoria y GPU (RTX 3090 24GB)
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=64
KV_CACHE_DTYPE=bfloat16
MAX_NUM_BATCHED_TOKENS=4096
ENABLE_PREFIX_CACHING=True

# CPU Offload / Swap Space (0 para máxima velocidad en VRAM GPU; >0 para habilitar swap a RAM)
SWAP_SPACE=0

# Cuantización opcional en tiempo de ejecución (ej. bitsandbytes, fp8, awq)
# QUANTIZATION=bitsandbytes
# LOAD_8_BITS=False # Establecer en True para forzar cuantización de 8 bits en lugar de 4 bits cuando QUANTIZATION=bitsandbytes
